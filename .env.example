# Copy to .env.development (or .env.production) and fill in the values.
PORT="9090"
NODE_ENV="development"
MAINTENANCE_MODE=false
APP_NAME="watch_store"
FRONTEND_URL="http://localhost:3000"
AUTH_ISSUER="http://localhost:3000"

# First super admin, created on boot when none exists (password: 12+ characters)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# PostgreSQL
DB_HOST="localhost"
DB_PORT="5432"
DB_USERNAME=""
DB_PASSWORD=""
DB_DATABASE="watch_store"
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Redis (sessions, OTPs, socket presence, unread-notification counters)
REDIS_URI="redis://127.0.0.1:6379"

# Files
MAX_IMAGE_SIZE_MB="10"
STORAGE_DIR="assets"
# 32 random bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=""

# Email (SMTP). Without it, development logs emails instead of sending them.
APP_MAIL=""
APP_PASSWORD=""

# JWT (seconds / random hex secrets: openssl rand -hex 32)
ACCESS_TOKEN_EXPIRES_IN="900"
REFRESH_TOKEN_EXPIRES_IN="604800"
ACCESS_USER_TOKEN_SIGNATURE=""
REFRESH_USER_TOKEN_SIGNATURE=""

OAUTH_GOOGLE_CLIENT_ID=""

# Commerce
STORE_CURRENCY="USD"
PAYMENT_WINDOW_MINUTES="30"
RETURN_WINDOW_DAYS="14"

# Payment & shipping providers
PAYMENT_PROVIDER="mock"
PAYMENT_MOCK_WEBHOOK_SECRET=""
SHIPPING_PROVIDER="mock"
SHIPPING_MOCK_WEBHOOK_SECRET=""
SHIPPING_HOME_COUNTRY="Egypt"

# Rate limiting (in-memory Nest throttler)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_TTL_SECONDS=60

# API docs (Swagger UI at /api/v1/docs). Defaults to on outside production.
# SWAGGER_ENABLED=true
